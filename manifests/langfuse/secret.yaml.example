---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: langfuse
  namespace: langfuse
stringData:
  # Langfuse application
  salt: "***"
  encryption-key: "***" # Generate with `openssl rand -hex 32`
  nextauth-secret: "***"

  # PostgreSQL — Langfuse reads `postgresql-password`; the groundhog2k sub-chart
  # also needs the POSTGRES_* / USERDB_* keys (keep passwords in sync).
  # postgresql-password: "newPostgresPassword123"
  # postgresql-user-password: "MyLangPassword"
  # POSTGRES_USER: "postgres"
  # POSTGRES_PASSWORD: "newPostgresPassword123"
  # POSTGRES_DB: "langfuse"
  # USERDB_USER: "langfuse"
  # USERDB_PASSWORD: "newPostgresPassword123"

  # ClickHouse
  clickhouse-password: "***"

  # Redis / Valkey — Langfuse reads `redis-password`; Valkey ACL uses key == username (`default`).
  redis-password: "***"
  default: "***"

  # SeaweedFS S3 — Langfuse reads s3-user / s3-password; the gateway also needs the IAM JSON.
  # s3-user: "my-s3-user"
  # s3-password: "***"
  # seaweedfs_s3_config: |
  #   {"identities":[{"name":"my-s3-user","credentials":[{"accessKey":"my-s3-user","secretKey":"***"}],"actions":["Admin","Read","Write","List","Tagging"]}]}
